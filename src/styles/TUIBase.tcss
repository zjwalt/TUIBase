QueryEditor, QueryResults {
  height: 1fr;
  border: round #515151;
  background: transparent;
  padding: 1 1;
}

DbExplorer {
  height: 1fr;
  width: 25%;
  border: round #515151;
  background: transparent;
  padding: 1 1;
}

DbExplorer:focus-within, QueryEditor:focus-within, QueryResults:focus-within {
  border: round #e3bdff;
}

QueryEditor {
  border-subtitle-align: left
}
